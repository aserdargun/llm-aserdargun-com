{
  "name": "llm-runtime-serving-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "run:local": "npm run stop:local && vite --host 127.0.0.1 --port 4173 --strictPort",
    "stop:local": "node tools/stop-local.mjs",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local-contract": "node --test tests/local-actions.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate:data && tsc -b && vite build",
    "check": "npm run validate:data && npm run test && npm run test:local-contract && npm run lint && npm run typecheck && npm run build",
    "validate": "npm run stop:local && npm run check && npm run test:e2e && git diff --check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@sparticuz/chromium": "^149.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/tar-fs": "^2.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tar-fs": "^3.1.3",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
